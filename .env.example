# Copy to .env and fill in. .env is gitignored — never commit it.
#
# ─────────────────────────────────────────────────────────────────────────────
# GEMINI
#
# Create a key at https://aistudio.google.com/apikey
#
# This is now the only working route for individuals. The `gemini` CLI's
# "Login with Google" used to spend a Google AI Pro subscription, but Google
# retired the free "Gemini Code Assist for individuals" tier for this client —
# the login still succeeds and then every call fails with IneligibleTierError.
#
# The key must also be selected as the auth type, once:
#     ~/.gemini/settings.json -> security.auth.selectedType = "gemini-api-key"
# A stale "oauth-personal" there silently overrides this variable.
#
# Keep it here rather than in .bashrc: cron does not source a login profile.

GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPENROUTER  (optional — only needed if ai.yaml routes a tier there)
#
# Create a key at https://openrouter.ai/keys
#
# Used for job scoring, which is the bulk of the call volume. Those prompts
# carry no name, phone, email or resume text — see the routing note in ai.yaml.
#
# HEADS UP: most `:free` endpoints require enabling "free endpoints that may
# train on your inputs" in your OpenRouter privacy settings. Check that setting
# before routing anything personal there.

OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# LINKEDIN
#
# Get these from https://www.linkedin.com/developers/apps after completing the
# one-time app setup described in the README ('LinkedIn setup'). Both products
# you need — "Share on LinkedIn" and "Sign In with LinkedIn using OpenID
# Connect" — are self-serve, free, and granted instantly.

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match a redirect URL registered on your app's Auth tab, exactly.
LINKEDIN_REDIRECT_URI=http://localhost:8765/callback

# Pin the LinkedIn API version (YYYYMM). Bump this deliberately, not casually:
# each version has a documented sunset date.
LINKEDIN_API_VERSION=202608
